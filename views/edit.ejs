<!DOCTYPE html>
<html>

<head>

    <title>Edit Product</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body class="bg-light">

    <div class="container mt-5">

        <h3>Edit Product</h3>

        <form method="POST" action="/product/<%= product._id %>/edit" enctype="multipart/form-data">

            <div class="row g-3">

                <div class="col-md-6">
                    <input name="name" placeholder="Product name" value="<%= product.name %>" class="form-control">
                </div>

                <div class="col-md-6">
                    <input name="price" placeholder="Product price" value="<%= product.price %>" class="form-control">
                </div>

                <div class="col-md-12">
                    <textarea name="description" placeholder="Product details"
                        class="form-control"><%= product.description %></textarea>
                </div>



                <div class="col-md-12">

                    <p>
                        <%= product.image %>
                    </p>
                    <!-- <img src="<%= product.imageUrl %>" class="img-fluid rounded"> -->

                </div>

                <div class="col-md-6">
                    <label>Current Image</label><br>
                    <p>
                        <%= product.image %>
                    </p>
                    <img src="<%= product.imageUrl %>" class="img-fluid rounded">
                </div>

                <div class="col-md-12">
                    <label>Change Image</label><br><br>
                    <input type="file" name="image" class="form-control">
                </div>

                <div class="col-md-12">
                    <button class="btn btn-primary">Update Product</button>
                </div>

            </div>

        </form>

    </div>

</body>

</html>