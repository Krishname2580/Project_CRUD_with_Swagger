<%- include('partials/header') %>


  <style>
    .product-card {
      height: 100%;
    }

    .product-card .card-body {
      display: flex;
      flex-direction: column;
    }

    .description {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      text-overflow: ellipsis;
      min-height: 48px;
    }

    .product-card .d-flex {
      margin-top: auto;
    }

    .product-image {
      width: 100%;
      height: 350px;
      /* Increase height */
      object-fit: cover;
      border-radius: 8px;
    }
  </style>

  <div class="bg-light border-bottom py-2">
    <div class="container d-flex flex-wrap fw-bold gap-5">

      <a href="/" class="text-dark text-decoration-none px-3">All</a>

      <% categories.forEach(function(cat) { %>
        <a href="/?category=<%= cat %>" class="text-dark text-decoration-none px-3">
          <%= cat %>
        </a>
        <% }) %>

          <!-- Home Route -->
          <a href="/home" class="text-dark text-decoration-none px-3">
            Home
          </a>

    </div>
  </div>
  <div class="container mt-3">
    <div class="row">

      <!-- LEFT: Filter Section -->
      <div class="col-md-3">
        <div class="card p-3 shadow-sm">

          <h5 class="mb-3 gap-4">Filters</h5>

          <form method="GET" action="/">

            <div class="accordion" id="filterAccordion">

              <!-- CLOTHING -->
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button" type="button" data-bs-toggle="collapse"
                    data-bs-target="#clothingCollapse">
                    CATEGORIES
                  </button>
                </h2>

                <div id="clothingCollapse" class="accordion-collapse collapse show">
                  <div class="accordion-body">

                    <% const clothings=["Men", "Women" ]; %>

                      <% clothings.forEach(function(clothing, index) { %>
                        <div class="form-check">
                          <input class="form-check-input" type="checkbox" name="category" value="<%= clothing %>"
                            id="cloth-<%= index %>">
                          <label class="form-check-label" for="cloth-<%= index %>">
                            <%= clothing %>
                          </label>
                        </div>
                        <% }) %>

                  </div>
                </div>
              </div>

              <!-- SIZE -->
              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#sizeCollapse">
                    SIZE
                  </button>
                </h2>

                <div id="sizeCollapse" class="accordion-collapse collapse">
                  <div class="accordion-body">

                    <% const sizes=["S","M","L","XL","XXL"]; %>

                      <% sizes.forEach(function(size, index) { %>
                        <div class="form-check">
                          <input class="form-check-input" type="checkbox" name="size" value="<%= size %>"
                            id="siz-<%= index %>">
                          <label class="form-check-label" for="size-<%= index %>">
                            <%= size %>
                          </label>
                        </div>
                        <% }) %>

                  </div>
                </div>
              </div>

            </div>

            <!-- Price -->

            <div class="card p-3">
              <h6 class="mb-3 fw-bold">PRICE</h6>

              <!-- Range Slider -->
              <input type="range" class="form-range" min="0" max="10000" step="100" id="priceRange" name="price"
                value="<%= price || 10000 %>">

              <p>Max Price: ₹<span id="priceValue">
                  <%= price || 10000 %>
                </span></p>
              <!-- Min / Max Display -->
              <div class="d-flex justify-content-between mt-2">
                <span>₹0</span>
                <span>₹10000</span>
              </div>

              <!-- Dropdowns like Flipkart -->
              <div class="d-flex gap-2 mt-3">
                <select class="form-select">
                  <option>Min</option>
                  <option>₹100</option>
                  <option>₹200</option>
                  <option>₹500</option>
                </select>

                <span class="align-self-center">to</span>

                <select class="form-select">
                  <option>₹1000+</option>
                  <option>₹5000+</option>
                  <option>₹10000+</option>
                </select>
              </div>
            </div>

            <script>
              const range = document.getElementById("priceRange");
              const value = document.getElementById("priceValue");

              range.addEventListener("input", function () {
                value.innerText = this.value;
              });
            </script>

            <button class="btn btn-primary w-100">Apply</button>

          </form>

        </div>
      </div>

      <!-- Products -->
      <div class="col-md-9">

        <div class="row">
          <% if(products.length===0){ %>

            <div class="text-center mt-5">
              <h3>No Products Found</h3>
            </div>

            <% } %>
              <% products.forEach(product=> { %>

                <div class="col-md-4 mb-4">
                  <div class="card shadow-sm product-card">
                    <img src="<%= product.imageUrl %>" class="product-image" height="150">
                    <div class="card-body">
                      <h6>
                        <%= product.name %>
                      </h6>
                      <p>₹ <%= product.price %>
                      </p>
                      <p class="description">
                        <%= product.description || "No description available" %>
                      </p>

                      <div class="d-flex justify-content-between mt-3">

                        <a href="/products/<%= product._id %>" class="btn btn-primary btn-sm">
                          <i class="fa-solid fa-eye"></i> View
                        </a>

                        <a href="/product/<%= product._id %>/edit" class="btn btn-warning btn-sm">
                          <i class="fa-solid fa-pen"></i> Edit
                        </a>

                        <a href="/product/<%= product._id %>/delete" class="btn btn-danger btn-sm"
                          onclick="return confirm('Are you sure you want to delete this product?')">
                          <i class="fa-solid fa-trash"></i> Delete
                        </a>

                      </div>
                    </div>
                  </div>
                </div>


                <% }) %>

                  <nav class="mt-4">
                    <% if (totalPages> 1) { %>
                      <ul class="pagination justify-content-center">

                        <% if (currentPage> 1) { %>
                          <li class="page-item">
                            <a class="page-link" href="/?page=<%= currentPage - 1 %>">
                              Previous
                            </a>
                          </li>
                          <% } %>

                            <% for(let i=1; i <=totalPages; i++) { %>
                              <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                <a class="page-link" href="/?page=<%= i %>">
                                  <%= i %>
                                </a>
                              </li>
                              <% } %>

                                <% if (currentPage < totalPages) { %>
                                  <li class="page-item">
                                    <a class="page-link" href="/?page=<%= currentPage + 1 %>">
                                      Next
                                    </a>
                                  </li>
                                  <% } %>

                      </ul>
                      <% } %>
                  </nav>
        </div>

      </div>

    </div>


    <%- include('partials/footer') %>